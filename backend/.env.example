# ──────────── Servidor ────────────
PORT=5000
NODE_ENV=development

# ──────────── Base de datos (MongoDB Atlas o local) ────────────
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<basedatos>

# ──────────── Autenticacion (JWT) ────────────
JWT_SECRET=cambiame-por-un-string-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN=7d

# ──────────── Integracion DeepSeek ────────────
DEEPSEEK_API_KEY=sk-tu-api-key-de-deepseek
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# ──────────── CORS ────────────
FRONTEND_URL=http://localhost:5173
